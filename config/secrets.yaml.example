# 機密設定範本（複製為 config/secrets.yaml 後填入實際值；secrets.yaml 已 gitignore）
# 非機密參數請放 config/quant_params.yaml（進版控）。

# FinMind API Token（逐股資料必需；TWSE/TPEX 免 token）
finmind:
  api_token: ""

# Anthropic Claude API Key（AI 選股摘要功能，--ai-summary 旗標需要）
# 在 https://console.anthropic.com 取得
anthropic:
  api_key: ""

# Discord Webhook URL
# 在 Discord 頻道設定 → 整合 → Webhook → 建立 Webhook，複製 URL
discord:
  webhook_url: ""

# healthchecks.io dead-man switch 完整 ping URL（如 https://hc-ping.com/<uuid>）
# 空字串 = 停用
monitoring:
  healthchecks_url: ""
